FROM docker.io/library/fedora:43

# Install Rust
RUN dnf update -y && dnf install -y curl
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain nightly
ENV PATH="/root/.cargo/bin:${PATH}"
RUN rustc --version

RUN mkdir /xav
WORKDIR /xav
COPY ./ /xav
RUN dnf install -y git glibc-static libstdc++-static nasm rustup clang clang-libs llvm lld compiler-rt llvm-libunwind-static autoconf automake libtool cmake ninja-build pkgconf meson ffmpeg curl gcc
RUN rustup component add rust-src --toolchain nightly-x86_64-unknown-linux-gnu
RUN /xav/build.sh static_tq essential
RUN cp /xav/target/x86_64-unknown-linux-gnu/release/xav /usr/bin/xav
